  ],
  "item": [
    {
      "name": "0. Saúde (rota pública)",
      "description": "Única rota de negócio que NÃO exige a API key.",
      "item": [
        {
          "name": "Saúde da aplicação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Deve responder 200 com status UP, mesmo sem a chave.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Carteiras",
      "description": "Criar uma carteira e consultar o saldo. A criação guarda o id em carteiraId para as próximas requisições.",
      "item": [
        {
          "name": "Criar carteira",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Cria uma carteira com saldo 0.00. O titular é opcional. Guarda o id em carteiraId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titular\": \"Maria Teste\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 e saldo 0.00', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.saldo).to.eql(0);",
                  "  pm.collectionVariables.set('carteiraId', c.id);",
                  "});",
                  "pm.test('Location aponta para a carteira', () => pm.expect(pm.response.headers.get('Location')).to.include('/wallets/' + pm.collectionVariables.get('carteiraId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar carteira",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}"
              ]
            },
            "description": "Devolve a carteira e o saldo atual (sempre com 2 casas decimais)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com o id certo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('carteiraId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar carteira inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "999999999"
              ]
            },
            "description": "Carteira que não existe: 404 no formato padrão de erro."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 com código de erro', () => { pm.response.to.have.status(404); pm.expect(pm.response.json()).to.have.property('codigo'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Operações (crédito, débito e idempotência)",
      "description": "Rode em ORDEM (ou use o Runner). Cada operação exige o header Idempotency-Key. A mesma chave repetida com o mesmo conteúdo NÃO altera o saldo de novo.",
      "item": [
        {
          "name": "Crédito de 100.00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chaveCredito}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ]
            },
            "description": "Aplica um crédito. Gera uma chave nova (chaveCredito) e a guarda para a repetição do próximo passo. Saldo esperado: 100.00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"CREDITO\",\n  \"valor\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('chaveCredito', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, sem marca de repetição e saldoApos 100', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const l = pm.response.json();",
                  "  pm.collectionVariables.set('lancamentoCredito', l.id);",
                  "  pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false;",
                  "  pm.expect(l.saldoApos).to.eql(100);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir o MESMO crédito (idempotência)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chaveCredito}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ]
            },
            "description": "Mesma chave e mesmo conteúdo (um retry depois de um timeout): 201 com o MESMO lançamento e o header Idempotent-Replayed: true. O saldo continua 100.00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"CREDITO\",\n  \"valor\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, marcado como repetição e mesmo lançamento', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true');",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('lancamentoCredito')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mesma chave com conteúdo diferente (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chaveCredito}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ]
            },
            "description": "A chave já foi usada com OUTRO conteúdo (aqui, outro valor): 409. Nada é alterado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"CREDITO\",\n  \"valor\": 999.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Débito de 30.00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chaveDebito}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
