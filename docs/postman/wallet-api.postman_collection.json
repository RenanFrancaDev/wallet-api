    {
      "name": "4. Extrato (paginação e período)",
      "description": "Do lançamento mais recente para o mais antigo. Só aparecem as operações APLICADAS (repetições e recusas não criam linha).",
      "item": [
        {
          "name": "Extrato completo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ]
            },
            "description": "Depois da pasta 2, devem existir 2 lançamentos (débito de 30 e crédito de 100, nessa ordem)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e o débito (mais recente) aparece', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(JSON.stringify(pm.response.json())).to.include('DEBITO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Extrato paginado (size=1, page=0)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions?page=0&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            },
            "description": "Uma página de 1 item: veja o total de itens e de páginas na resposta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Extrato por período [from, to)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions?from={{periodoDe}}&to={{periodoAte}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{periodoDe}}"
                },
                {
                  "key": "to",
                  "value": "{{periodoAte}}"
                }
              ]
            },
            "description": "from é inclusivo e to é exclusivo. O pre-request monta uma janela de 1 hora atrás até 1 hora à frente."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const agora = Date.now();",
                  "pm.collectionVariables.set('periodoDe', new Date(agora - 3600000).toISOString());",
                  "pm.collectionVariables.set('periodoAte', new Date(agora + 3600000).toISOString());"
                ]
              }
            },
            {
