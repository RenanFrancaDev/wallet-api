                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('chaveDebito', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 e saldoApos 70', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().saldoApos).to.eql(70); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Débito maior que o saldo (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{chaveRecusada}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}",
                "transactions"
              ]
            },
            "description": "Tenta debitar 500.00 com saldo 70.00: 422 (saldo insuficiente). Não cria linha no extrato.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"DEBITO\",\n  \"valor\": 500.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('chaveRecusada', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar saldo (deve ser 70.00)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{carteiraId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{carteiraId}}"
              ]
            },
            "description": "Conferência: 100 - 30 = 70. A repetição, o conflito e a recusa não mexeram no saldo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('saldo 70', () => pm.expect(pm.response.json().saldo).to.eql(70));"
                ]
              }
            }
          ]
        }
      ]
    },
