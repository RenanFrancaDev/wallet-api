            },
            "description": "Débito dentro do saldo. Saldo esperado: 70.00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"DEBITO\",\n  \"valor\": 30.00\n}",
              "options": {
                "raw": {
                  "language": "json"
