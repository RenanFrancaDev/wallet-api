{
  "info": {
    "_postman_id": "93dffbcc-adf9-5d27-b14c-300f6b6edbaf",
    "name": "Wallet API",
    "description": "Coleção para testar e simular transações da Wallet API.\n\nComo usar: importe esta coleção e o ambiente 'Wallet API - local', escolha o ambiente, preencha a variável apiKey com o valor de WALLET_API_KEY do seu .env e rode as pastas em ordem (ou use o Collection Runner na coleção inteira).\n\nA chave NUNCA deve ser colocada em arquivo versionado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
